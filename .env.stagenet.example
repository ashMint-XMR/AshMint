# STAGENET ONLY — never use this verifier or launch ID on mainnet.
PORT=8788
XMR_NETWORK=stagenet
XMR_STAGING_ACKNOWLEDGED=true
XMR_LAUNCH_ENABLED=true
XMR_LAUNCH_ID=ash-xmr-stagenet-v0
XMR_RATE=1000
XMR_MIN_BURN_ATOMIC=1000000000
XMR_CAP=1000000
XMR_MIN_CONFIRMATIONS=10

# Run your own stagenet monero-wallet-rpc and create a disposable stagenet test address.
XMR_WALLET_RPC_URL=http://127.0.0.1:28088/json_rpc
XMR_WALLET_RPC_USER=SET_LOCAL_STAGENET_USER
XMR_WALLET_RPC_PASSWORD=SET_LOCAL_STAGENET_PASSWORD
XMR_BURN_ADDRESS=SET_DISPOSABLE_STAGENET_ADDRESS
XMR_BURN_POLICY_COMMITMENT=SET_64_HEX_TEST_POLICY_COMMITMENT
XMR_BURN_VERIFIER=monero-burn-stagenet-v0
XMR_BURN_VERIFIER_PATH=node
XMR_BURN_VERIFIER_ARGS=./scripts/stagenet-verifier.mjs
XMR_DATA_FILE=./data/stagenet-receipts.json
FUTURE_TOKEN_SYMBOL=ASH
FUTURE_TOKEN_REFERENCE=
