# XMR receipt launch — copy to a secret manager; do not commit a populated file.
NODE_ENV=production
PORT=8788
XMR_NETWORK=mainnet
XMR_LAUNCH_ENABLED=false
XMR_LAUNCH_ID=ash-xmr-receipts-v1
XMR_RATE=1000
XMR_MIN_BURN_ATOMIC=100000000000
XMR_CAP=100000000
XMR_MIN_CONFIRMATIONS=20

# Dedicated, self-hosted, TLS-protected monero-wallet-rpc. It must be a
# restricted verification service, never an unlocked spend wallet.
XMR_WALLET_RPC_URL=https://wallet-rpc.example.com/json_rpc
XMR_WALLET_RPC_USER=SET_IN_SECRET_MANAGER
XMR_WALLET_RPC_PASSWORD=SET_IN_SECRET_MANAGER

# Immutable audited burn policy. Commitment is lower-case SHA-256 hex.
XMR_BURN_ADDRESS=SET_AFTER_AUDIT
XMR_BURN_POLICY_COMMITMENT=SET_AFTER_AUDIT
XMR_BURN_VERIFIER=monero-burn-v1
XMR_BURN_VERIFIER_PATH=/opt/ash/bin/monero-burn-verifier
XMR_DATA_FILE=/var/lib/ash/receipts.json

# Public future-token metadata. Do not use STAMP's mint; $ASH requires its own
# independently verified mint address.
FUTURE_TOKEN_SYMBOL=ASH
FUTURE_TOKEN_REFERENCE=SET_AFTER_ASH_MINT

# Mandatory before opening the later Solana claim phase.
SOLANA_RPC_URL=https://your-solana-rpc.example.com
ASH_MINT_ADDRESS=SET_AFTER_ASH_MINT
ASH_CLAIM_AUTHORITY=SET_TO_MULTISIG_OR_PROGRAM
ASH_CLAIM_MERKLE_ROOT=SET_AFTER_FINAL_SNAPSHOT
ASH_CLAIM_START_AT=SET_AS_ISO_8601
ASH_CLAIM_END_AT=SET_AS_ISO_8601
