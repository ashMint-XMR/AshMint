# Keep this file as a template only. Store production values in a secret manager.
PORT=8788
XMR_NETWORK=mainnet
XMR_LAUNCH_ENABLED=false
XMR_LAUNCH_ID=xmr-burn-receipts-v1
XMR_RATE=1000
XMR_MIN_BURN_ATOMIC=100000000000
XMR_CAP=100000000
XMR_MIN_CONFIRMATIONS=20

# A self-hosted, authenticated monero-wallet-rpc instance. It must expose only
# check_tx_key to this service; never expose an unlocked spend wallet.
XMR_WALLET_RPC_URL=http://127.0.0.1:18088/json_rpc
XMR_WALLET_RPC_USER=replace-me
XMR_WALLET_RPC_PASSWORD=replace-me

# Must be created and reviewed together with the verifier.
XMR_BURN_ADDRESS=
XMR_BURN_POLICY_COMMITMENT=
XMR_BURN_VERIFIER=monero-burn-v1
XMR_BURN_VERIFIER_PATH=
FUTURE_TOKEN_SYMBOL=ASH
# Leave blank until the actual $ASH Solana mint is created and independently verified.
FUTURE_TOKEN_REFERENCE=
# Claim phase (not required for receipt collection). Configure before opening claims.
SOLANA_RPC_URL=
ASH_MINT_ADDRESS=
ASH_CLAIM_AUTHORITY=
ASH_CLAIM_MERKLE_ROOT=
ASH_CLAIM_START_AT=
ASH_CLAIM_END_AT=
XMR_DATA_FILE=./data/receipts.json
